<view class="page">
  <!-- 下一次 + 进度 -->
  <view class="card next-card">
    <view class="row">
      <view class="flex1">
        <text class="cap">下一次训练</text>
        <view class="next-t"><text class="num accent">{{vm.next.day}}</text> {{vm.next.name}}</view>
        <text class="cap">{{vm.next.weekText}}{{vm.next.deload ? ' · 减载周' : ''}}</text>
      </view>
      <view class="go-btn" data-day="{{vm.next.day}}" bindtap="goNext">开始</view>
    </view>
    <view class="prog">
      <view class="row between"><text class="cap">本轮进度（{{vm.weeksPerCycle}} 周 / 轮）</text><text class="cap"><text class="num strong">{{vm.cycleDone}}</text> / {{vm.cyclePlanned}} 次 · {{vm.cycleProgress}}%</text></view>
      <view class="bar"><view class="bar-in" style="width: {{vm.cycleProgress}}%"></view></view>
      <text class="cap total-cap">累计已完成 {{vm.done}} 次训练</text>
    </view>
  </view>

  <!-- 矩阵 -->
  <view class="card">
    <view class="card-title">
      <view class="cyc-nav">
        <text class="cyc-btn {{vm.canPrev ? '' : 'off'}}" data-d="-1" bindtap="onCycle">‹</text>
        <text class="t cyc-label">{{vm.cycleText}}{{vm.isFuture ? ' · 预览' : vm.isCurCycle ? ' · 进行中' : ''}}</text>
        <text class="cyc-btn {{vm.canNext ? '' : 'off'}}" data-d="1" bindtap="onCycle">›</text>
      </view>
      <text class="s">{{vm.progression === 'w531' ? '顶组 kg' : vm.progression === 'gzclp' ? 'T1 重量 kg' : '主项重量 kg'}}</text>
    </view>
    <view class="grid-head">
      <text class="gw"></text>
      <text wx:for="{{vm.days}}" wx:key="id" class="gh num">{{item.id}}</text>
    </view>
    <view wx:for="{{vm.rows}}" wx:key="week" wx:for-item="row" class="grid-row">
      <view class="gw"><text class="num">W{{row.wc}}</text><text class="dltag" wx:if="{{row.deload}}">减载</text></view>
      <view wx:for="{{row.cells}}" wx:key="day" wx:for-item="c" class="gcell {{c.status}}" data-c="{{c}}" bindtap="onCell">
        <text class="cw num">{{c.w}}</text>
        <view class="cdot" wx:if="{{c.status === 'done'}}" style="background: {{c.color}}"></view>
      </view>
    </view>
    <view class="legend">
      <view class="lg"><view class="sw" style="background: #FF6B1A"></view>已完成 · 圆点为判定</view>
      <view class="lg"><view class="sw" style="box-shadow: inset 0 0 0 2px #FF6B1A"></view>下一次</view>
      <view class="lg"><view class="sw" style="background: #E5E5EA"></view>每次加重的推演</view>
    </view>
  </view>

  <!-- 本轮动作编排 -->
  <view class="card rot-card" wx:if="{{vm.rotation}}">
    <view class="card-title">
      <text class="t">{{vm.cycleText}}动作编排</text>
      <text class="s">{{!vm.rotation.enabled ? '自动轮换已关闭' : vm.rotation.cycle === 1 ? '起始动作' : '换了 ' + vm.rotation.changed + ' / ' + vm.rotation.total + ' 个'}}</text>
    </view>
    <view class="rot-tip">T1 四大项固定；T2/T3 每轮在同一动作模式内换一次，一轮 {{vm.weeksPerCycle}} 周内保持不变{{vm.rotation.isFuture ? '。这一轮还没开始，以下为预排' : ''}}</view>
    <view class="rot-day" wx:for="{{vm.rotation.days}}" wx:key="id" wx:for-item="d">
      <view class="rot-dh"><text class="num rot-did">{{d.id}}</text><text class="rot-dn">{{d.name}}</text></view>
      <view class="rot-row" wx:for="{{d.slots}}" wx:key="id" wx:for-item="r">
        <text class="tier t-{{r.tier}}">{{r.tier}}</text>
        <view class="rot-main">
          <view class="rot-n">{{r.name}}<text class="equip-tag eq-{{r.equip}}">{{r.equip}}</text><text class="rot-new" wx:if="{{r.isNew}}">新</text><text class="rot-lock" wx:if="{{r.locked}}">锁定</text></view>
          <view class="rot-s">{{r.role}}{{r.isNew ? ' · 上一轮 ' + r.prev : ''}}{{r.startW ? ' · 起始 ' + r.startW : ''}}</view>
        </view>
      </view>
    </view>
    <view class="rot-why-btn" bindtap="toggleWhy">{{showWhy ? '收起编排依据' : '查看编排依据'}}<text class="chev">{{showWhy ? '⌃' : '›'}}</text></view>
    <view class="rot-why" wx:if="{{showWhy}}">
      <view class="rw" wx:for="{{vm.rotation.principles}}" wx:key="t"><text class="rw-t">{{index + 1}}. {{item.t}}</text><text class="rw-d">{{item.d}}</text></view>
    </view>
  </view>

  <!-- 当前状态 -->
  <view class="card">
    <view class="card-title"><text class="t">当前状态</text><text class="s">自动更新</text></view>
    <view class="seg">
      <view wx:for="{{vm.overview}}" wx:key="day" class="seg-i {{ovIdx === index ? 'on' : ''}}" data-i="{{index}}" bindtap="onOv"><text class="num">{{item.day}}</text></view>
    </view>
    <view class="ov-row" wx:for="{{vm.overview[ovIdx].slots}}" wx:key="id">
      <text class="tier t-{{item.tier}}">{{item.tier}}</text>
      <view class="ov-main">
        <text class="ovn">{{item.name}}</text>
        <text class="ov-sub">{{item.stage}}<text class="amber" wx:if="{{item.fail > 0}}"> · 预警 {{item.fail}}</text></text>
      </view>
      <view class="ov-right">
        <text class="num ov-w">{{item.weight}}<text class="ov-u"> kg</text></text>
        <text class="ov-last"><text style="color: {{item.lastColor}}">{{item.last}}</text><text class="green" wx:if="{{item.gain}}"> {{item.gain}}</text></text>
      </view>
    </view>
  </view>

  <!-- 详情 -->
  <view class="mask" wx:if="{{detail}}" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">
      <view class="grabber"></view>
      <text class="sheet-cap">{{detail.dateText}} · 第 {{detail.week}} 次 · 容量 {{detail.vol}} kg</text>
      <view class="sheet-title">{{detail.day}} {{detail.dayName}}</view>
      <view class="list">
        <view class="cell d-row" wx:for="{{detail.items}}" wx:key="name">
          <text class="tier t-{{item.tier}}">{{item.tier}}</text>
          <view class="d-main"><text>{{item.name}}</text><text class="d-sub">{{item.w}} kg × {{item.input}}<text class="accent" wx:if="{{item.manual}}"> · 手动</text></text></view>
          <view class="d-right"><text class="jtag" style="color: {{item.color}}">{{item.j}}</text><text class="d-sub">{{item.next}}</text></view>
        </view>
      </view>
      <view class="note-box" wx:if="{{detail.note}}">{{detail.note}}</view>
      <view class="sheet-btns">
        <view class="btn-ghost" data-id="{{detail.id}}" bindtap="editRecord">修改这次</view>
        <view class="btn-ghost solid" bindtap="closeDetail">完成</view>
      </view>
    </view>
  </view>
</view>

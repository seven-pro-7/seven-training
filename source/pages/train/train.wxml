<view class="page">
  <view class="set-screen screen-{{log.screen}}" wx:if="{{log}}">
    <view class="set-top">
      <view class="back-btn" bindtap="logBack" aria-role="button" aria-label="返回今日列表">‹</view>
      <view class="gear-btn" bindtap="goMe" aria-role="button" aria-label="设置"><view class="gear-dot"></view></view>
    </view>
    <view class="set-scroll" wx:if="{{log.screen === 'rest'}}">
      <text class="rest-kicker">{{log.restKicker}}</text>
      <text class="rest-clock">{{log.restText}}</text>
      <view class="rest-track"><view class="rest-fill" style="width: {{log.restPct}}%"></view></view>
      <text class="rest-name">{{log.name}} · 组间休息</text>
      <text class="rest-next">{{log.restNext}}</text>
    </view>
    <view class="set-scroll" wx:elif="{{log.screen === 'done'}}">
      <text class="done-kicker">本动作已记下</text>
      <text class="set-name">{{log.name}}</text>
      <text class="set-scheme">{{log.scheme}}</text>
      <view class="set-path">
        <view wx:for="{{log.dots}}" wx:key="i" class="sp {{item.cls}}"><text class="dot">{{item.mark}}</text><text class="lab">{{item.i + 1}}</text></view>
      </view>
      <view class="set-log">
        <view wx:for="{{log.rows}}" wx:key="i" class="set-log-row" data-i="{{item.i}}" bindtap="logFix"><text>{{item.label}}</text><text class="b">{{item.text}}</text><text class="fix">更正</text></view>
      </view>
      <view class="engine-card" wx:if="{{log.engineJudgment}}">
        <text class="engine-j">{{log.engineJudgment}}</text>
        <text class="engine-next">{{log.engineNext}}</text>
        <text class="hint">{{log.engineNote}}</text>
      </view>
    </view>
    <view class="set-scroll" wx:elif="{{log.screen === 'correct'}}">
      <text class="set-meta">{{log.stamp}}</text>
      <text class="set-name">{{log.corTitle}}</text>
      <text class="set-scheme">{{log.name}} · {{log.scheme}}</text>
      <view class="origin-card"><text>原记录</text><text class="b">{{log.origin}}</text></view>
      <text class="block-label">更正次数</text>
      <view class="rep-step">
        <view class="st-btn" data-k="r" data-d="-1" bindtap="corStep">−</view>
        <text class="st-val">{{log.corReps}}</text>
        <view class="st-btn" data-k="r" data-d="1" bindtap="corStep">+</view>
      </view>
      <text class="block-label">重量</text>
      <view class="rep-step">
        <view class="st-btn" data-k="w" data-d="-1" bindtap="corStep">−</view>
        <text class="st-val">{{log.corW}}</text>
        <view class="st-btn" data-k="w" data-d="1" bindtap="corStep">+</view>
      </view>
      <text class="hint">保存后会标明已更正。后面的组还在。中间组次数不改写进阶。</text>
    </view>
    <view class="set-scroll" wx:elif="{{log.screen === 'fail'}}">
      <text class="set-name">{{log.failTitle}}</text>
      <text class="hint">本机写入没有成功。不是云同步问题。你刚填的重量和次数都还在，可以再试一次。</text>
      <view class="origin-card"><text>仍保留的输入</text><text class="b">{{log.failKeep}}</text><text>{{log.name}}</text></view>
    </view>
    <view class="set-scroll" wx:else>
      <text class="set-meta">{{log.stamp}}</text>
      <text class="set-name">{{log.name}}</text>
      <text class="set-scheme">{{log.scheme}}</text>
      <view class="weight-row" wx:if="{{log.showWeight}}"><text class="big-kg">{{log.weight}}</text><text class="unit">{{log.unit}}</text></view>
      <view class="set-path">
        <view wx:for="{{log.dots}}" wx:key="i" class="sp {{item.cls}}"><text class="dot">{{item.mark}}</text><text class="lab">{{item.i + 1}}</text></view>
      </view>
      <text class="path-cap">{{log.pathCap}}</text>
      <view class="set-log" wx:if="{{log.collapsed}}"><view class="set-log-row"><text>{{log.collapsed}}</text></view></view>
      <view class="set-log" wx:elif="{{log.rows.length}}">
        <view wx:for="{{log.rows}}" wx:key="i" class="set-log-row" data-i="{{item.i}}" bindtap="logFix"><text>{{item.label}}</text><text class="b">{{item.text}}</text><text class="fix">{{item.note}}</text></view>
      </view>
      <text class="target">{{log.target}}</text>
      <view class="rep-step">
        <view class="st-btn" data-k="r" data-d="-1" bindtap="logStep">−</view>
        <input class="st-val" type="number" value="{{log.reps}}" bindinput="onLogReps" />
        <view class="st-btn" data-k="r" data-d="1" bindtap="logStep">+</view>
      </view>
      <text class="hint" wx:if="{{log.hint}}">{{log.hint}}</text>
    </view>
    <view class="log-bottom" wx:if="{{log.screen === 'rest'}}">
      <view class="rest-controls">
        <view class="st-btn" data-d="-30" bindtap="logRest">−30</view>
        <view class="rest-skip" bindtap="logSkipRest">跳过休息</view>
        <view class="st-btn" data-d="30" bindtap="logRest">+30</view>
      </view>
      <text class="rest-suggest">{{log.badge}} 建议 {{log.restMin}} 分钟</text>
      <view class="text-link" bindtap="logUndo">撤销这一组</view>
    </view>
    <view class="log-bottom" wx:elif="{{log.screen === 'done'}}">
      <button class="home-cta" wx:if="{{log.nextSlot}}" data-slot="{{log.nextSlot}}" bindtap="logNext">{{log.nextLabel}}</button>
      <button class="home-cta" wx:else bindtap="logBack">返回今日列表</button>
      <view class="text-link" wx:if="{{log.nextSlot}}" bindtap="logBack">返回今日列表</view>
    </view>
    <view class="log-bottom" wx:elif="{{log.screen === 'correct'}}">
      <button class="home-cta" bindtap="logCorrectSave">保存更正</button>
      <view class="home-links"><text wx:if="{{log.showUndo}}" bindtap="logUndo">撤销这一组</text><text bindtap="logWork">返回</text></view>
    </view>
    <view class="log-bottom" wx:elif="{{log.screen === 'fail'}}">
      <button class="home-cta" bindtap="logSave">再试一次</button>
      <view class="text-link" bindtap="logWork">先留在本页</view>
    </view>
    <view class="log-bottom" wx:else>
      <button class="home-cta" bindtap="logSave" disabled="{{!log.canSave}}">{{log.cta}}</button>
      <view class="home-links"><text data-slot="{{log.slot}}" bindtap="openSwap">换动作</text><text class="sep">·</text><text data-slot="{{log.slot}}" bindtap="onSkip">跳过</text></view>
      <view class="text-link" wx:if="{{log.rows.length}}" bindtap="logUndo">撤销上一组</view>
    </view>
  </view>
  <view class="muse-home {{home.live ? 'session-live' : 'session-ready'}}" wx:elif="{{vm}}">
    <view class="home-wash"></view>
    <view class="gear-btn" bindtap="goMe" aria-role="button" aria-label="设置"><view class="gear-dot"></view></view>
    <view class="home-scroll">
      <view class="session-guide">
        <view class="pedestal">
          <image class="companion-slot" src="/assets/companion-idle.svg" mode="aspectFit" aria-label="训练伙伴" />
          <view class="ground-shadow"></view>
        </view>
        <text class="guide-title">{{home.prompt}}</text>
      </view>
      <view class="training-block">
      <view class="session-context">
        <text class="when-line">{{home.stamp}}</text>
        <text class="session-position">第 {{home.index}} / {{home.total}} 个动作</text>
      </view>
      <view class="bk-nag" wx:if="{{saveFail}}">这次训练还没记到本机。草稿还在，可以再点完成训练。这不是云同步问题。</view>

      <view class="card locked" wx:if="{{vm.locked && vm.lockedInfo}}">
        <view class="lk-head">
          <view class="lk-ic">✓</view>
          <view class="flex1">
            <view class="lk-t">本周 {{vm.day}} 已完成</view>
            <view class="lk-s">{{vm.lockedInfo.dateText}} · 容量 {{vm.lockedInfo.vol}} kg</view>
          </view>
        </view>
        <view class="sess-list">
          <view class="sess-row" wx:for="{{vm.lockedInfo.items}}" wx:key="name">
            <text class="tier t-{{item.tier}}">{{item.badge || item.tier}}</text>
            <view class="sess-main">
              <text class="sess-name">{{item.name}}</text>
              <text class="sess-sub">{{item.detail}}</text>
              <text class="sess-ctx" wx:if="{{item.context}}">{{item.context}}</text>
            </view>
            <view class="sess-right">
              <text class="jtag" style="color: {{item.color}}">{{item.j}}</text>
              <text class="sess-next" wx:if="{{item.next}}">{{item.next}}</text>
            </view>
          </view>
        </view>
        <view class="lk-tip">下周的 {{vm.day}} 会在本周 {{vm.round.leftText}} 完成后开放</view>
        <button class="btn-primary lk-share" data-id="{{vm.lockedInfo.id}}" bindtap="openShare">查看今日战报</button>
        <view class="sheet-btns">
          <view class="btn-ghost" data-id="{{vm.lockedInfo.id}}" bindtap="onEditLocked">修改这次</view>
          <view class="btn-ghost solid" data-day="{{vm.recommended}}" bindtap="onDay">去练 {{vm.recommended}}</view>
        </view>
      </view>

      <block wx:if="{{!vm.locked}}">
        <view class="edit-cancel" wx:if="{{vm.editing}}" bindtap="cancelEdit">取消编辑</view>
        <block wx:for="{{exBlocks}}" wx:for-item="block" wx:key="key">
        <view class="ex {{block.item.current ? 'current' : 'upcoming'}} {{block.item.doneLogged ? 'is-done' : ''}} {{block.item.skip ? 'skipped' : ''}} {{expanded && block.item.current ? 'is-open' : ''}}">
          <view class="ex-hit" data-slot="{{block.item.slotId}}" bindtap="onRow" aria-role="button" aria-label="{{block.item.current ? '当前动作' : '后续动作'}} · {{block.item.name}}">
            <view class="ordinal"><text>{{block.item.ord}}</text></view>
            <view class="ex-body">
              <view class="ex-top">
                <view class="name">{{block.item.name}}<view wx:if="{{block.item.doneLogged}}" class="ex-done" aria-label="已完成"></view></view>
                <view class="wt">
                  <block wx:if="{{block.item.isCardio}}"><text class="kg">{{block.item.weightText}}</text><text class="unit">分钟</text></block>
                  <block wx:elif="{{block.item.isBW}}"><text class="kg bw">自重</text></block>
                  <block wx:else><text class="kg {{block.item.manual ? 'manual' : ''}}">{{block.item.weightText}}</text><text class="unit">{{block.item.unitText}}</text></block>
                </view>
              </view>
              <view class="ex-meta">
                <text class="scheme">{{block.item.skip ? '已跳过' : block.item.schemeText}}</text>
                <view class="sets" wx:if="{{block.item.current && block.item.done > 0 && !block.item.doneLogged && !block.item.skip}}">
                  <view class="set-pips"><view wx:for="{{block.item.pips}}" wx:for-item="pip" wx:key="i" class="pip {{pip.cls}}"></view></view>
                  <text class="sets-count">{{block.item.done}} / {{block.item.sets}} 组</text>
                </view>
              </view>
              <view class="ex-flags" wx:if="{{block.item.sub}}"><text class="ex-tag sub">替换 {{block.item.planName}}</text></view>
              <view class="ex-flags" wx:elif="{{block.item.autoNew}}"><text class="ex-tag rot">本轮轮换 · 原 {{block.item.autoPrev}}</text></view>
              <view class="ex-flags" wx:elif="{{block.item.changeNew}}"><text class="ex-tag new">新动作</text></view>
            </view>
          </view>
          <view class="more-pop" wx:if="{{moreOpen}}" catchtap="noop">
            <view wx:if="{{block.item.canAdjust}}" data-slot="{{block.item.slotId}}" bindtap="onEditW">{{block.item.editW ? '完成调整' : '调整重量'}}</view>
            <view data-slot="{{block.item.slotId}}" bindtap="openSwap">更换</view>
            <view data-slot="{{block.item.slotId}}" bindtap="onSkip">{{block.item.skip ? '恢复' : '跳过'}}</view>
            <view bindtap="onMenu">日期与备注</view>
          </view>
          <view class="t1-open ex-log" wx:if="{{expanded && block.item.current}}">
            <view class="log-tool" wx:if="{{block.item.canAdjust}}" data-slot="{{block.item.slotId}}" catchtap="onEditW">{{block.item.editW ? '完成调整' : '调整重量'}}</view>
            <view class="wedit" wx:if="{{block.item.editW}}">
              <view class="stepper">
                <view class="st-btn" data-slot="{{block.item.slotId}}" data-d="-1" bindtap="onWStep">−</view>
                <input class="st-val wide num" type="digit" value="{{block.item.weightText}}" data-slot="{{block.item.slotId}}" bindblur="onWInput" bindconfirm="onWInput" />
                <view class="st-btn" data-slot="{{block.item.slotId}}" data-d="1" bindtap="onWStep">+</view>
              </view>
              <text class="we-step">每次 {{block.item.wStepText}} kg</text>
              <text class="link we-reset" wx:if="{{block.item.manual}}" data-slot="{{block.item.slotId}}" bindtap="onWReset">恢复 {{block.item.autoText}}</text>
            </view>
            <block wx:if="{{!block.item.skip}}">
              <view class="dots" wx:if="{{block.item.inputType !== 'cardio'}}">
                <view wx:for="{{block.item.dots}}" wx:for-item="d" wx:key="i" class="dot {{d.on ? 'on' : ''}} {{d.amrap ? 'amrap' : ''}}"
                  data-slot="{{block.item.slotId}}" data-i="{{d.i}}" data-rest="{{block.item.rest}}" data-name="{{block.item.name}}" bindtap="onDot">{{d.amrap ? (d.i + 1) + '+' : d.i + 1}}</view>
                <view class="rest-btn" data-rest="{{block.item.rest}}" data-name="{{block.item.name}}" bindtap="startRest">休息 {{block.item.restText}}</view>
              </view>
              <view class="inrow col" wx:if="{{block.item.inputType === 'cardio'}}">
                <view class="seg seg-done">
                  <view class="seg-i {{block.item.value !== null && block.item.value !== '' && block.item.value >= block.item.amrapTarget ? 'on ok' : ''}}" data-slot="{{block.item.slotId}}" bindtap="onCardioDone">完成</view>
                </view>
              </view>
              <view class="inrow" wx:if="{{block.item.inputType === 'cardio'}}">
                <view class="flex1"><view class="in-label">实际分钟</view><view class="in-hint">{{block.item.amrapHint}}</view></view>
                <view class="stepper">
                  <view class="st-btn" data-slot="{{block.item.slotId}}" data-d="-1" bindtap="onStep">−</view>
                  <input class="st-val num" type="number" value="{{block.item.value === null ? '' : block.item.value}}" placeholder="{{block.item.amrapTarget}}" placeholder-class="ph" data-slot="{{block.item.slotId}}" bindinput="onAmrap" />
                  <view class="st-btn" data-slot="{{block.item.slotId}}" data-d="1" bindtap="onStep">+</view>
                </view>
              </view>
              <view class="inrow" wx:if="{{block.item.inputType === 'amrap'}}">
                <view class="flex1"><view class="in-label">末组次数</view><view class="in-hint">{{block.item.amrapHint}}</view></view>
                <view class="stepper">
                  <view class="st-btn" data-slot="{{block.item.slotId}}" data-d="-1" bindtap="onStep">−</view>
                  <input class="st-val num" type="number" value="{{block.item.value === null ? '' : block.item.value}}" placeholder="—" placeholder-class="ph" data-slot="{{block.item.slotId}}" bindinput="onAmrap" />
                  <view class="st-btn" data-slot="{{block.item.slotId}}" data-d="1" bindtap="onStep">+</view>
                </view>
              </view>
              <view class="inrow" wx:if="{{block.item.need5RM}}">
                <view class="flex1"><view class="in-label">新 5RM</view><view class="in-hint">未达标时按新 5RM 的 85% 重置</view></view>
                <input class="mini-in num" type="digit" value="{{block.item.new5RM}}" placeholder="kg" placeholder-class="ph" data-slot="{{block.item.slotId}}" bindinput="on5RM" />
              </view>
              <view class="inrow col" wx:if="{{block.item.inputType === 'done'}}">
                <view class="seg seg-done">
                  <view class="seg-i {{block.item.value === '完成' ? 'on ok' : ''}}" data-slot="{{block.item.slotId}}" data-v="完成" bindtap="onDone">全部完成</view>
                  <view class="seg-i {{block.item.value === '未完成' ? 'on bad' : ''}}" data-slot="{{block.item.slotId}}" data-v="未完成" bindtap="onDone">未完成</view>
                </view>
                <view class="in-hint" wx:if="{{block.item.amrapHint}}">{{block.item.amrapHint}}</view>
                <view class="subrow" wx:if="{{block.item.value === '未完成'}}">
                  <text class="in-hint">实际总次数（选填，不填则这次不计入容量）</text>
                  <input class="mini-in num" type="number" value="{{block.item.reps2}}" placeholder="次数" placeholder-class="ph" data-slot="{{block.item.slotId}}" bindinput="onReps" />
                </view>
              </view>
              <view class="verdict" wx:if="{{block.item.preview}}">
                <view class="v-ic" style="background: {{block.item.preview.color}}">{{block.item.preview.icon}}</view>
                <text class="v-j" style="color: {{block.item.preview.color}}">{{block.item.preview.judgment}}</text>
                <text class="v-l" wx:if="{{block.item.preview.sub}}">不影响 {{block.item.preview.origName}} 的进阶</text>
                <view class="v-next" wx:elif="{{block.item.isCardio}}"><text class="v-l">下次</text><text class="num v-w">{{block.item.preview.nextStage}}</text></view>
                <view class="v-next" wx:elif="{{block.item.preview.judgment !== '减载'}}">
                  <text class="v-l">下次</text><text class="num v-w">{{block.item.preview.nextWeight}}</text><text class="v-u">kg</text>
                  <text class="v-stage" wx:if="{{block.item.preview.stageChanged}}">· {{block.item.preview.nextStage}}</text>
                </view>
                <text class="v-l" wx:else>按减载重量完成</text>
              </view>
              <view class="v-adapt" wx:if="{{block.item.preview.boost && block.item.preview.adaptNote}}"><text class="v-adapt-t">多加一档</text>{{block.item.preview.adaptNote}}</view>
              <view class="ex-sub" wx:if="{{block.item.recSourceLabel || block.item.manual || block.item.plates || block.item.fail > 0}}">
                <text wx:if="{{block.item.recSourceLabel}}">{{block.item.recSourceLabel}}</text>
                <text class="accent" wx:if="{{block.item.manual}}">已手动调整 · 建议 {{block.item.autoText}} kg</text>
                <text wx:if="{{block.item.plates}}">{{block.item.plates}}</text>
                <text class="amber" wx:if="{{block.item.fail > 0}}">已预警 {{block.item.fail}} 次</text>
              </view>
            </block>
          </view>
        </view>

        </block>
        <view class="home-action" wx:if="{{!vm.locked && home.cta}}">
          <button class="home-cta" bindtap="onStart">{{home.cta}}</button>
          <view class="home-links" wx:if="{{!home.started && !home.ready}}"><text bindtap="onAdjust">调整今天</text></view>
          <view class="home-links" wx:elif="{{!home.ready}}"><text data-slot="{{home.slot}}" bindtap="openSwap">换动作</text><text class="sep">·</text><text data-slot="{{home.slot}}" bindtap="onSkip">{{home.skipLabel}}</text></view>
          <view class="home-links" wx:else><text bindtap="onAdjust">日期与备注</text></view>
        </view>
      </block>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{menuOpen}}" bindtap="onMenuClose">
    <view class="sheet session-sheet" catchtap="noop">
      <view class="grabber"></view>
      <text class="sheet-cap">{{vm.weekText}}{{vm.editing ? ' · 编辑记录' : ''}}</text>
      <view class="sheet-title">调整今天</view>
      <view class="seg day-seg" wx:if="{{vm && !vm.editing}}">
        <view wx:for="{{vm.days}}" wx:key="id" class="seg-i {{item.id === vm.day ? 'on' : ''}}" data-day="{{item.id}}" bindtap="onDay">{{item.id}}</view>
      </view>
      <view class="deload-slim" wx:if="{{vm && !vm.locked && (vm.deloadSuggest || vm.deload)}}">
        <text class="dl-t">减载周</text>
        <text class="dl-s">{{vm.deloadTip || '降低负荷恢复'}}</text>
        <switch checked="{{vm.deload}}" color="#5BB887" bindchange="onDeload" />
      </view>
      <view class="list">
        <view class="cell">
          <text class="flex1">日期</text>
          <picker mode="date" value="{{date}}" bindchange="onDate" disabled="{{vm.locked}}"><text class="num">{{dateText}}</text></picker>
        </view>
        <view class="cell">
          <text class="flex1">体重</text>
          <input class="cell-in num" type="digit" value="{{bw}}" placeholder="可选" placeholder-class="ph" bindinput="onBw" />
          <text class="unit">kg</text>
        </view>
        <view class="cell note-cell">
          <textarea class="note" value="{{note}}" placeholder="备注：状态、睡眠、技术要点" placeholder-class="ph" auto-height maxlength="200" bindinput="onNote" />
        </view>
      </view>
      <view class="sheet-btns" wx:if="{{vm.editing}}"><view class="btn-ghost" bindtap="cancelEdit">取消编辑</view></view>
    </view>
  </view>

  <!-- 更换动作 -->
  <view class="mask" wx:if="{{swap.show}}" bindtap="closeSwap">
    <view class="sheet swap-sheet" catchtap="noop">
      <view class="grabber"></view>
      <text class="sheet-cap">{{swap.slotTier}} · 当前 {{swap.curName}}{{swap.planName !== swap.curName ? '（原 ' + swap.planName + '）' : ''}}</text>
      <view class="row between"><view class="sheet-title">更换动作</view><text class="link" wx:if="{{swap.isSub}}" bindtap="swapRestore">恢复 {{swap.planName}}</text></view>
      <view class="search"><text class="search-ic">⌕</text><input class="search-in" value="{{swap.q}}" placeholder="搜索动作、部位或器械" placeholder-class="ph" bindinput="swapQ" /></view>
      <view class="seg" wx:if="{{!swap.q && swap.slotTier !== 'T1'}}">
        <view wx:for="{{swap.lib.tiers}}" wx:key="id" class="seg-i {{swap.tier === item.id ? 'on' : ''}}" data-t="{{item.id}}" bindtap="swapTier">{{item.label}}<text class="seg-n">{{item.n}}</text></view>
      </view>
      <view class="sec-f t1-only" wx:if="{{swap.slotTier === 'T1'}}">{{vm.progression === 'gzclp' ? 'T1 严格限定四大项，只能在深蹲、卧推、硬拉、实力推之间选择。' : '当前为主项，建议选择同模式的复合大重量动作。'}}</view>
      <scroll-view scroll-y class="lib-list">
        <view class="list">
          <view wx:for="{{swap.lib.list}}" wx:key="name" class="cell tap lib-row {{swap.sel === item.name ? 'sel' : ''}}" data-name="{{item.name}}" bindtap="swapPick">
            <view class="flex1">
              <view class="lib-n">{{item.name}}<text class="tier t-{{item.tier}} lib-t" wx:if="{{swap.q || item.tier !== swap.slotTier}}">{{item.tier}}</text><text class="lib-c" wx:if="{{item.custom}}">自定义</text></view>
              <view class="lib-s"><text class="equip-tag eq-{{item.equip}}">{{item.equip}}{{item.equip === '哑铃' ? '·单只' : item.equip === '负重' ? '·外加' : ''}}</text>{{item.part}}{{item.last ? ' · 上次 ' + item.last + ' ' + item.recUnit : ''}}</view>
              <view class="lib-rec" wx:if="{{item.equip === '有氧'}}">{{item.recNote}}</view>
              <view class="lib-rec" wx:else>推荐 {{item.rec}}{{item.recUnit === '自重' ? '' : ' ' + item.recUnit}} · {{item.recNote}}</view>
            </view>
            <text class="lib-cur" wx:if="{{item.current}}">当前</text>
            <text class="lib-ck" wx:if="{{swap.sel === item.name}}">✓</text>
          </view>
          <view class="empty-tip" wx:if="{{!swap.lib.list.length}}">没有找到，可在「设置 → 动作库」添加自定义动作</view>
        </view>
      </scroll-view>
      <block wx:if="{{swap.sel}}">
        <view class="seg swap-scope" wx:if="{{!swap.editing}}">
          <view class="seg-i {{swap.scope === 'once' ? 'on' : ''}}" data-s="once" bindtap="swapScope">仅本次</view>
          <view class="seg-i {{swap.scope === 'perm' ? 'on' : ''}}" data-s="perm" bindtap="swapScope">以后都用</view>
        </view>
        <view class="swap-rec"><text class="equip-tag eq-{{swap.selEquip}}">{{swap.selEquip}}{{swap.selEquip === '哑铃' ? '·单只' : swap.selEquip === '负重' ? '·外加' : ''}}</text><view><view class="swap-rec-v">推荐 {{swap.recText}} {{swap.recUnit === '自重' ? '' : swap.recUnit}}</view><view class="swap-rec-n">{{swap.recSourceLabel}}{{swap.recSourceLabel && swap.recNote ? ' · ' : ''}}{{swap.recNote}}</view></view></view>
        <view class="list" wx:if="{{swap.scope === 'perm' && swap.selEquip !== '自重'}}">
          <view class="cell"><text class="flex1">起始重量</text><input class="cell-in num" type="digit" value="{{swap.weight}}" bindinput="swapWeight" /><text class="unit">{{swap.recUnit}}</text></view>
        </view>
        <view class="sec-f">{{swap.scope === 'once' ? '本次用推荐重量练「' + swap.sel + '」，记录容量，不改变「' + swap.planName + '」的阶段和重量。' : '从第 ' + swap.week + ' 周起，' + swap.dayId + ' 的这个位置改为「' + swap.sel + '」，按 ' + swap.slotTier + ' 规则从起始重量重新进阶；历史记录保持不变。' + (swap.rotates ? '下一轮仍按轮换计划自动编排（可在设置里锁定这个位置）。' : '')}}</view>
        <button class="btn-primary swap-ok" bindtap="swapConfirm">确认更换</button>
      </block>
    </view>
  </view>

  <!-- 组间休息 -->
  <view class="mask center rest-mask" wx:if="{{rest.show && !log}}">
    <view class="rest-box">
      <text class="rest-name">{{rest.name}} · 组间休息</text>
      <text class="rest-num num">{{rest.text}}</text>
      <view class="rest-bar"><view class="rest-in" style="width: {{rest.pct}}%"></view></view>
      <view class="rest-btns">
        <view class="rb" data-d="-30" bindtap="adjRest">−30</view>
        <view class="rb main" bindtap="stopRest">跳过休息</view>
        <view class="rb" data-d="30" bindtap="adjRest">+30</view>
      </view>
    </view>
  </view>

  <!-- 结算 -->
  <view class="mask" wx:if="{{result}}" bindtap="closeResult">
    <view class="sheet" catchtap="noop">
      <view class="grabber"></view>
      <text class="sheet-cap">{{result.day}} {{result.dayName}} · {{result.weekText}}</text>
      <view class="sheet-title">{{result.cycleDone ? '第 ' + result.cycle + ' 轮完成' : result.weekDone ? '本周完成' : '训练完成'}}</view>
      <view class="wk-done" wx:if="{{result.cycleDone}}">第 {{result.cycle}} 轮 {{result.weeksPerCycle}} 周全部完成，进入第 {{result.cycle + 1}} 轮{{result.nextDeload ? '（含减载周）' : ''}}</view>
      <view class="wk-left" wx:if="{{result.cycleDone && result.rotated}}">{{vm.progression === 'gzclp' ? '已按轮换计划更换 ' + result.rotated + ' 个 T2/T3 动作，T1 四大项不变。当前动作在「计划」的当前状态里。' : '已按计划更换变式。当前动作在「计划」的当前状态里。'}}</view>
      <view class="wk-done" wx:elif="{{result.weekDone}}">A1 · B1 · A2 · B2 全部完成，已进入{{result.nextWeekText}}{{result.nextDeload ? '（减载周）' : ''}}</view>
      <view class="wk-left" wx:elif="{{result.leftText}}">本周还剩 {{result.leftText}}</view>
      <view class="res-kpi">
        <view class="rk"><text class="num rk-v">{{result.volume}}</text><text class="rk-l">容量 kg</text></view>
        <view class="rk"><text class="num rk-v accent">{{result.adds}}</text><text class="rk-l">项加重</text></view>
      </view>
      <view class="list">
        <view class="cell res-row" wx:for="{{result.items}}" wx:key="name">
          <text class="tier t-{{item.tier}}">{{item.badge || item.tier}}</text>
          <text class="res-name flex1">{{item.name}}</text>
          <view class="res-r">
            <text class="jtag" style="color: {{item.color}}">{{item.j}}</text>
            <text class="res-next num">{{item.next}}</text>
          </view>
        </view>
      </view>
      <view class="sheet-btns stack">
        <button class="btn-primary share-result" data-id="{{result.logId}}" bindtap="openShare">生成今日战报</button>
        <view class="row">
          <view class="btn-ghost" bindtap="gotoStats">查看数据</view>
          <view class="btn-ghost solid" bindtap="closeResult">好</view>
        </view>
      </view>
    </view>
  </view>
  <share-sheet show="{{share.show}}" kind="{{share.kind}}" record-id="{{share.recordId}}" week="{{share.week}}" ym="{{share.ym}}" bindclose="closeShare" />
</view>

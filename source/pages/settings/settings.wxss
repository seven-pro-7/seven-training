.sec-h:first-child { padding-top: 8rpx; }
.f-in { width: 140rpx; height: 56rpx; text-align: right; font-size: 32rpx; color: var(--label); }
.f-in.sm { width: 90rpx; height: 52rpx; text-align: center; font-size: 28rpx; background: var(--fill); border-radius: 12rpx; margin: 0 10rpx; }
.f-u { color: var(--label2); margin-left: 8rpx; font-size: 30rpx; }
.tm { color: var(--label2); font-size: 26rpx; margin-right: 24rpx; }

.mode-seg { margin-bottom: 0; }

.slot { flex-direction: column; align-items: stretch; padding: 24rpx 32rpx; }
.slot-top { display: flex; align-items: center; }
.ex-pick { margin-left: 16rpx; font-size: 32rpx; font-weight: 500; display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.init { font-size: 32rpx; font-weight: 600; }
.init .f-u { font-size: 24rpx; font-weight: 400; }
.slot-cfg { display: flex; align-items: center; margin-top: 16rpx; font-size: 26rpx; }
.mini-seg { display: flex; background: var(--fill); border-radius: 12rpx; padding: 3rpx; margin-right: 16rpx; }
.ms { padding: 6rpx 16rpx; color: var(--label2); font-size: 22rpx; font-weight: 600; border-radius: 10rpx; }
.ms.on { background: var(--card); color: var(--label); box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.12); }
.base-pick { font-size: 26rpx; color: var(--label); display: flex; align-items: center; margin-right: 8rpx; }
.step { margin-left: auto; font-size: 24rpx; color: var(--label2); }

.imp { width: 100%; height: 220rpx; background: var(--fill2); border-radius: 16rpx; padding: 16rpx; box-sizing: border-box; font-size: 24rpx; color: var(--label); }

.slot-chg { font-size: 22rpx; color: var(--green); margin-top: 8rpx; }
.slot-rec { display: flex; align-items: flex-start; gap: 12rpx; font-size: 22rpx; color: var(--accent); margin-top: 8rpx; line-height: 1.45; }
.rec-apply { flex-shrink: 0; font-size: 23rpx; font-weight: 600; padding: 4rpx 14rpx; border-radius: 999rpx; background: var(--accent-soft); }
.cfg-l { font-size: 22rpx; color: var(--label2); margin-right: 12rpx; }
.init-step { font-size: 22rpx; color: var(--label2); margin-right: 16rpx; white-space: nowrap; }
.cfg-l, .mini-seg, .ms, .base-pick { white-space: nowrap; flex-shrink: 0; }

.slot-rot { display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; color: #0A84FF; margin-top: 8rpx; }
.rot-lock-btn { flex-shrink: 0; font-size: 23rpx; font-weight: 600; padding: 4rpx 14rpx; border-radius: 999rpx; color: var(--label2); background: var(--fill); }
.rot-lock-btn.on { color: #fff; background: #8E8E93; }

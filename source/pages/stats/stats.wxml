<view class="page">
  <view class="kpis">
    <view class="kpi">
      <text class="k-l">训练次数</text>
      <view><text class="num kv">{{s.kpi.sessions}}</text><text class="ku">/ {{s.kpi.planned}}</text></view>
      <view class="kbar"><view class="kin" style="width: {{s.kpi.progress}}%"></view></view>
    </view>
    <view class="kpi"><text class="k-l">累计容量</text><text class="num kv">{{s.kpi.volume}}</text><text class="ks">{{s.kpi.reps}} 次</text></view>
    <view class="kpi"><text class="k-l">加重</text><view><text class="num kv accent">{{s.kpi.adds}}</text><text class="ku">次</text></view><text class="ks">预警 {{s.kpi.warns}}</text></view>
    <view class="kpi"><text class="k-l">T1 达标率</text><text class="num kv">{{s.kpi.t1Rate === null ? '—' : s.kpi.t1Rate + '%'}}</text><text class="ks">T2 完成 {{s.kpi.t2Rate === null ? '—' : s.kpi.t2Rate + '%'}}</text></view>
  </view>

  <!-- e1RM -->
  <view class="card">
    <view class="seg">
      <view wx:for="{{s.e1rm}}" wx:key="key" class="seg-i {{liftIdx === index ? 'on' : ''}}" data-i="{{index}}" bindtap="onLift">{{item.name}}</view>
    </view>
    <text class="cap">最佳 e1RM</text>
    <view class="hero"><text class="num hero-v">{{cur.best}}</text><text class="hero-u">kg</text><text class="cap hero-d">{{cur.bestDate}}</text></view>
    <canvas type="2d" id="c_e1" class="cv"></canvas>
    <view class="mini">
      <view class="mi"><text class="num mi-v">{{cur.slope}}</text><text class="mi-l">kg / 周</text></view>
      <view class="mi"><text class="num mi-v">{{cur.r2}}</text><text class="mi-l">R²</text></view>
      <view class="mi"><text class="num mi-v accent">{{cur.predict}}</text><text class="mi-l">W{{s.totalWeeks}} 预测</text></view>
    </view>
    <view class="tip" wx:if="{{cur.sampleTip}}">{{cur.sampleTip}}</view>
    <view class="tip" wx:elif="{{cur.vs1RM !== null && cur.vs1RM > 3}}">已超过录入 1RM {{cur.vs1RM}}%，可以在设置里更新 1RM</view>
    <view class="legend">
      <view class="lg"><view class="sw" style="background: #FF6B1A"></view>e1RM</view>
      <view class="lg"><view class="sw dash" style="border-color: #0A84FF"></view>回归趋势</view>
      <view class="lg"><view class="sw dash" style="border-color: #C7C7CC"></view>录入 1RM</view>
    </view>
  </view>

  <!-- 重量走势 -->
  <view class="card">
    <view class="card-title"><text class="t">重量走势</text><text class="s">空心点为下次计划</text></view>
    <view class="seg">
      <view wx:for="{{s.weightTrend}}" wx:key="day" class="seg-i {{dayIdx === index ? 'on' : ''}}" data-i="{{index}}" bindtap="onDayTab"><text class="num">{{item.day}}</text></view>
    </view>
    <canvas type="2d" id="c_w" class="cv"></canvas>
    <view class="legend">
      <view class="lg" wx:for="{{s.weightTrend[dayIdx].cols}}" wx:key="name"><view class="sw" style="background: {{palette[index]}}"></view>{{item.name}}</view>
    </view>
  </view>

  <!-- 容量 -->
  <view class="card">
    <view class="card-title"><text class="t">每周容量</text><text class="s">重量 × 组 × 次</text></view>
    <canvas type="2d" id="c_v" class="cv"></canvas>
    <view class="legend">
      <view class="lg" wx:for="{{s.volume.stacks}}" wx:key="name"><view class="sw" style="background: {{item.color}}"></view>{{item.name}}</view>
    </view>
  </view>

  <!-- 判定分布 -->
  <view class="card">
    <view class="card-title"><text class="t">判定分布</text><text class="s">全部训练日</text></view>
    <view class="row">
      <canvas type="2d" id="c_p" class="cv-sq"></canvas>
      <view class="pie-list">
        <view class="pl" wx:for="{{s.pie}}" wx:key="label">
          <view class="sw" style="background: {{item.color}}"></view>
          <text class="pl-l">{{item.label}}</text>
          <text class="num pl-v">{{item.value}}</text>
          <text class="pl-p num">{{item.pct}}%</text>
        </view>
        <view class="cap" wx:if="{{!s.pie.length}}">暂无判定</view>
      </view>
    </view>
  </view>

  <!-- 最高重量 -->
  <view class="sec-h">最高重量</view>
  <view class="list">
    <view class="cell pr" wx:for="{{s.prs}}" wx:key="name">
      <text class="tier t-{{item.tier}}">{{item.tier}}</text>
      <view class="pr-main"><text>{{item.name}}</text><text class="pr-sub">{{item.day}} · {{item.date}}</text></view>
      <text class="num pr-w">{{item.w}}<text class="pr-u"> kg</text></text>
    </view>
    <view class="empty-tip" wx:if="{{!s.prs.length}}">完成训练后显示</view>
  </view>

  <block wx:if="{{s.bw.length >= 2}}">
    <view class="sec-h">体重</view>
    <view class="card"><canvas type="2d" id="c_bw" class="cv short"></canvas></view>
  </block>
</view>
